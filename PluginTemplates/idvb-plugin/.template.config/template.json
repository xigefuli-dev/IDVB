{
  "$schema": "http://json.schemastore.org/template",
  "author": "Identity Vision Bridge",
  "classifications": [ "IDVB", "Plugin" ],
  "identity": "IdentityVisionBridge.Plugin.Template.CSharp",
  "name": "Identity Vision Bridge Plugin",
  "shortName": "idvb-plugin",
  "sourceName": "IdvbPluginTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "pluginId": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "example.plugin",
      "replaces": "example.plugin"
    },
    "publisherId": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "example.publisher",
      "replaces": "example.publisher"
    }
  }
}

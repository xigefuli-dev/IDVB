        ]
      },
      {
        "lo": [
          135,
          100,
          100
        ],
        "hi": [
          165,
          255,
          255
        ]
      }
    ],
    "route_mask_dilate_kernel": [
      5,
      5
    ],
    "route_repair_radius_px": 5.0
  },
  "provenance": {
    "status": "local-validation-candidate",
    "target_map_class": "S0 厄运之女 · 困难",
    "note": "Dedicated Wang Qingxin pipeline. Local-contrast wall separation preserves bright floors; saturated annotation ranges preserve navy voids. Requires an engine supporting wall_min_contrast and exclude_routes. Shadow boundaries still require visual review."
  }
}

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IDVBuff.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modules="using:IDVBuff.Modules">

    <Page.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="ModuleNavTemplate">
            <Grid HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Tag="{Binding}"
                        Style="{StaticResource NavigationButtonStyle}"
                        Click="Navigation_ParentClick"
                        Loaded="NavigationRow_Loaded"
                        Unloaded="NavigationRow_Unloaded">
                    <Grid Height="40" Margin="12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0"
                                    Symbol="{Binding Icon}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Tag="{Binding}"
                                   Text="{Binding ExpansionGlyph}"
                                   Visibility="{Binding ExpansionVisibility}"
                                   Width="18"
                                   Height="24"
                                   Margin="0,0,16,0"
                                   FontSize="18"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Loaded="NavigationExpansionGlyph_Loaded"
                                   Unloaded="NavigationExpansionGlyph_Unloaded">
                        </TextBlock>
                    </Grid>
                </Button>
                <ItemsControl Grid.Row="1"
                              Tag="{Binding}"
                              ItemsSource="{Binding Children}"
                              Visibility="{Binding ChildrenVisibility, Mode=OneTime}"
                              ItemContainerStyle="{StaticResource NavigationItemContainerStyle}"
                              Loaded="NavigationChildren_Loaded"
                              Unloaded="NavigationChildren_Unloaded">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Click="Navigation_ChildClick"
                                    Loaded="NavigationRow_Loaded"
                                    Unloaded="NavigationRow_Unloaded">
                                    <Grid Height="40" Margin="38,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Margin="24,0,0,0"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0">
                <Button ToolTipService.ToolTip="Back" Style="{StaticResource SubtleButtonStyle}" Click="Back_Click"><SymbolIcon Symbol="Back" /></Button>
                <Image Width="24" Height="24" Stretch="Uniform" Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Margin="9,0,4,0" />
                <TextBlock Text="Identity Vision Bridge" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <AutoSuggestBox Grid.Column="1" PlaceholderText="Search modules..." Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" QueryIcon="Find" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4" Margin="0,0,12,0">
                <Button Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Settings" Click="Settings_Click"><SymbolIcon Symbol="Setting" /></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="NavigationSurface" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" LayoutUpdated="NavigationSurface_LayoutUpdated">
                <Border x:Name="NavigationSelectionIndicator"
                        Height="40"
                        Margin="4,16,4,0"
                        VerticalAlignment="Top"
                        Background="#DCE6F2"
                        CornerRadius="4"
                        IsHitTestVisible="False" />
                <Border x:Name="NavigationHoverIndicator"
                        Height="40"
                        Margin="4,16,4,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False" />
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PrimaryNavigation"
                                  Margin="0,14,0,18"
                                  ItemsSource="{x:Bind NavigationItems}"
                                  ItemTemplate="{StaticResource ModuleNavTemplate}"
                                  ItemContainerStyle="{StaticResource NavigationItemContainerStyle}"
                                  PointerMoved="Navigation_PointerMoved"
                                  PointerExited="Navigation_PointerExited" />
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <ScrollViewer x:Name="MainContentHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentPresenter x:Name="ModuleContentHost" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 引用自包含的 IDVBuff 主项目（WinExe）要求调用方也指定 RID，否则触发 NETSDK1151 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseSystemDrawing>true</UseSystemDrawing>
    <RootNamespace>IDVBuff.RealCLI</RootNamespace>
    <AssemblyName>IDVB.RealCLI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 与主项目 IDVBuff.csproj 一致：自包含打包 WindowsAppSDK 运行时，
         使 RealCLI 可独立运行，无需机器上单独安装 Windows App Runtime。 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <IDVBTorchRuntimePackage Condition="'$(IDVBTorchRuntimePackage)' == ''">TorchSharp-cpu</IDVBTorchRuntimePackage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Test'">
    <DefineConstants>$(DefineConstants);IDVBUFF_TEST_BUILD</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Read the source project's version on every build without building WinUI
       or consuming/incrementing the main application's build counter. -->
  <Target Name="GenerateRealCliVersion" BeforeTargets="CoreCompile">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\IDVBuff.csproj"
             Query="/Project/PropertyGroup[not(@Condition)]/IDVBProductVersion/text()">
      <Output TaskParameter="Result" ItemName="_RealCliProductVersionValue" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\IDVBuff.csproj"
             Query="/Project/PropertyGroup[not(@Condition)]/AssemblyVersion/text()">
      <Output TaskParameter="Result" ItemName="_RealCliNumericVersionValue" />
    </XmlPeek>
    <Error Condition="'@(_RealCliProductVersionValue->Count())' != '1' Or '@(_RealCliNumericVersionValue->Count())' != '1'"
           Text="RealCLI requires one unconditional IDVBProductVersion and AssemblyVersion in IDVBuff.csproj." />
    <PropertyGroup>
      <_RealCliProductVersion>@(_RealCliProductVersionValue)</_RealCliProductVersion>
      <_RealCliNumericVersion>@(_RealCliNumericVersionValue)</_RealCliNumericVersion>
    </PropertyGroup>
    <ItemGroup>
      <_RealCliVersionSource Include="// &lt;auto-generated /&gt;" />
      <_RealCliVersionSource Include="[assembly: System.Reflection.AssemblyVersion(&quot;$(_RealCliNumericVersion)&quot;)]" />
      <_RealCliVersionSource Include="[assembly: System.Reflection.AssemblyFileVersion(&quot;$(_RealCliNumericVersion)&quot;)]" />
      <_RealCliVersionSource Include="[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(_RealCliProductVersion)-RealCLI&quot;)]" />
      <_RealCliVersionSource Include="namespace IDVBuff%3B" />
      <_RealCliVersionSource Include="internal static partial class BuildVersionInfo {" />
      <_RealCliVersionSource Include="public const string ProductVersion = &quot;$(_RealCliProductVersion)&quot;%3B" />
      <_RealCliVersionSource Include="public const string NumericVersion = &quot;$(_RealCliNumericVersion)&quot;%3B" />
      <_RealCliVersionSource Include="}" />
      <Compile Include="$(IntermediateOutputPath)RealCLI.Version.g.cs" AutoGen="true" Visible="false" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)RealCLI.Version.g.cs"
                      Lines="@(_RealCliVersionSource)" Encoding="UTF-8"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- 引用真实 IDVB 程序集（Core/Infrastructure/Pipeline）
       注意：不能 ProjectReference 主项目 IDVBuff.csproj（WinExe，自包含）——
       会触发 NETSDK1151 / MSIX AnyCPU 检查。改为像 Probe/Tests 一样链接 Features 源码，
       确保走与主应用完全相同的编译产物，同时保持主程序与 RealCLI 构建互不干扰。 -->
  <ItemGroup>
    <ProjectReference Include="..\Core\IDVBuff.Core.csproj" />
    <ProjectReference Include="..\IDVBuff.Appearance\IDVBuff.Appearance.csproj" />
    <ProjectReference Include="..\Infrastructure\IDVBuff.Infrastructure.csproj" />
    <ProjectReference Include="..\Pipeline\IDVBuff.Pipeline.csproj" />
    <ProjectReference Include="..\Survey\Domain\IDVBuff.Survey.Domain.csproj" />
    <ProjectReference Include="..\Survey\Contracts\IDVBuff.Survey.Contracts.csproj" />
    <ProjectReference Include="..\Survey\Application\IDVBuff.Survey.Application.csproj" />
    <ProjectReference Include="..\Survey\Persistence\IDVBuff.Survey.Persistence.Sqlite.csproj" />
    <ProjectReference Include="..\Survey\Preprocessing\IDVBuff.Survey.Preprocessing.OpenCv.csproj" />
    <ProjectReference Include="..\Survey\Registration\IDVBuff.Survey.Registration.OpenCv.csproj" />
    <ProjectReference Include="..\Survey\PoseGraph\IDVBuff.Survey.PoseGraph.csproj" />
    <ProjectReference Include="..\Survey\Fusion\IDVBuff.Survey.Fusion.OpenCv.csproj" />
    <ProjectReference Include="..\Survey\Idvm\IDVBuff.Survey.Idvm.csproj" />
    <!-- MapGlobalInputService 使用 PluginHostMessages.InputInjectionMarkers 区分
         宿主生成的注入输入；RealCLI 链接 Features/Maps 源码，必须能解析该命名空间。 -->
    <ProjectReference Include="..\IDVBuff.PluginHostMessages\IDVBuff.PluginHostMessages.csproj" />
    <ProjectReference Include="..\IDVBuff.PluginContracts\IDVBuff.PluginContracts.csproj" />
    <ProjectReference Include="..\UpdateCore\IDVBuff.UpdateCore.csproj" />
  </ItemGroup>

  <!-- 链接主项目源码：Features 全部（纯 Win32 窗口，无 XAML）+ 根目录必要文件 -->
  <ItemGroup>
    <Compile Include="..\AppDataPaths.cs" Link="Production\AppDataPaths.cs" />
    <Compile Include="..\Features\Accounts\VersionAccessClient.cs" Link="Production\VersionAccessClient.cs" />
    <Compile Include="..\Features\Accounts\VersionAccessProof.cs" Link="Production\VersionAccessProof.cs" />
    <Compile Include="..\Lifecycle\UsageNotice.cs" Link="Production\Lifecycle\UsageNotice.cs" />
    <Compile Include="..\Lifecycle\MainProgramPreferences.cs" Link="Production\Lifecycle\MainProgramPreferences.cs" />
    <Compile Include="..\ServiceCollectionExtensions.cs" Link="Production\ServiceCollectionExtensions.cs" />
    <Compile Include="..\Cli\RealCliCandidateSelector.cs" Link="Production\Cli\RealCliCandidateSelector.cs" />
    <Compile Include="..\Diagnostics\OutputLog.cs" Link="Production\Diagnostics\OutputLog.cs" />
    <Compile Include="..\Diagnostics\OutputLog.Context.cs" Link="Production\Diagnostics\OutputLog.Context.cs" />
    <Compile Include="..\Diagnostics\RealtimePerformanceTracker.cs" Link="Production\Diagnostics\RealtimePerformanceTracker.cs" />
    <Compile Include="..\Diagnostics\StartupTimeline.cs" Link="Production\Diagnostics\StartupTimeline.cs" />
    <Compile Include="..\Features\QuickStart\QuickStartRecommendedSettings.cs" Link="Production\Features\QuickStart\QuickStartRecommendedSettings.cs" />
    <Compile Include="..\Features\Maps\**\*.cs" Link="Production\Features\Maps\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- ServiceCollectionExtensions registers the screenshot capability even
         in headless mode; link only its dependency instead of pulling the
         WinUI-facing plugin pages into the real replay host. -->
    <Compile Include="..\Features\Plugins\PluginScreenshotService.cs" Link="Production\Features\Plugins\PluginScreenshotService.cs" />
    <Compile Include="..\Features\Plugins\PluginGameWindowService.cs" Link="Production\Features\Plugins\PluginGameWindowService.cs" />
    <Compile Include="..\Features\Windows\WindowCaptureProtectionService.cs" Link="Production\Features\Windows\WindowCaptureProtectionService.cs" />
    <Compile Include="..\Features\Notifications\**\*.cs" Link="Production\Features\Notifications\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The production map control panel now uses shared theme scopes. Link
         those implementations; headless replay never creates a UI scope. -->
    <Compile Include="..\Presentation\Theming\**\*.cs" Link="Production\Presentation\Theming\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\GaussianBlurBackdrop.cs" Link="Production\GaussianBlurBackdrop.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="$(IDVBTorchRuntimePackage)" Version="0.107.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <!-- 运行时需要的模板资产 -->
  <ItemGroup>
    <None Include="..\Assets\Gate.png" Link="Assets\Gate.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\1F.png" Link="Assets\1F.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\2F.png" Link="Assets\2F.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Assets\FloorIndicators\**\*" Link="Assets\FloorIndicators\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Algorithms\structure-native-observed-v2.idva" Link="Assets\Algorithms\structure-native-observed-v2.idva" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Algorithms\structure-doom-girl-hard-wangqingxin-v1.idva" Link="Assets\Algorithms\structure-doom-girl-hard-wangqingxin-v1.idva" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

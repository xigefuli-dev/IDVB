<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseSystemDrawing>true</UseSystemDrawing>
    <RootNamespace>IDVBuff.Infrastructure</RootNamespace>
    <AssemblyName>IDVB.Infrastructure</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\IDVBuff.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Configuration\default.toml" CopyToOutputDirectory="PreserveNewest" Link="IDVB_config.toml" />
    <Content Include="Configuration\survey.toml" CopyToOutputDirectory="PreserveNewest" Link="IDVB_survey.toml" />
    <Content Include="Configuration\Presets\**\*.toml" CopyToOutputDirectory="PreserveNewest" LinkBase="Presets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tommy" Version="3.1.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>
</Project>

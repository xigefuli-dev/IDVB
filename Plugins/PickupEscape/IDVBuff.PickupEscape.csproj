<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IDVBuff.Plugins.PickupEscape</RootNamespace>
    <AssemblyName>IDVB.PickupEscape</AssemblyName>
    <PackageId>IdentityVisionBridge.PickupEscape</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\IDVBuff.PluginContracts\IDVBuff.PluginContracts.csproj" />
    <ProjectReference Include="..\..\IDVBuff.PluginHostMessages\IDVBuff.PluginHostMessages.csproj" />
    <!-- IGameOverlayToast（游戏内浮层提示），与「对局快捷键」用的是同一条 Core 契约。 -->
    <ProjectReference Include="..\..\Core\IDVBuff.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 只取托管封装；原生 OpenCvSharpExtern.dll 由主程序输出目录提供。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
  </ItemGroup>
  <ItemGroup>
    <!-- 场景识别模板：与「背包辅助」用的同一批 1920×1080 截图裁剪。 -->
    <EmbeddedResource Include="Templates\*.png" />
  </ItemGroup>
</Project>
